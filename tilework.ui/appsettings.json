{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "LuckyPennySoftware.AutoMapper.License": "None"
    }
  },
  "LoadBalancing": {
    "Backend" : "haproxy",
    "BackendImage" : "tilework/loadbalancer-haproxy:latest"
  },
  "CertificateManagement": {
    "AcmeVerificationImage" : "tilework/acmevalidator:latest",
    "CertRenewalLeadTime" : "7.00:00:00"
  },
  "Monitoring": {
    "DataCollector" : {
      "Backend" : "telegraf",
      "BackendImage" : "telegraf:1.36"
    },
    "DataPersistence" : {
      "Backend" : "influxdb",
      "BackendImage" : "influxdb:2.7"
    }
  },
  "LogCollection" : {
    "DataCollector" : {
      "Backend" : "alloy",
      "BackendImage" : "grafana/alloy:v1.18.1"
    },
    "DataPersistence" : {
      "Backend" : "loki",
      "BackendImage" : "grafana/loki:3.7.6"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection" : "Data Source=/var/lib/tilework/data.db"
  },
  "AllowedHosts": "*"
}
