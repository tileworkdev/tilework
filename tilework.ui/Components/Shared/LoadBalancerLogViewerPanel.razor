@using System.Globalization
@using System.Net
@using Tilework.Core.Enums
@using Tilework.LoadBalancing.Enums
@using Tilework.LoadBalancing.Models
@using Tilework.Ui.Services

<MudCard Outlined="true" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Title</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <div class="d-flex align-items-center pt-2">
                <MudToggleGroup Class="mr-3" T="string" Value="_selectedRange" Color="Color.Primary"
                                ValueChanged="OnRangeChanged" Style="width: 20rem">
                    <MudToggleItem Value="@("1h")" />
                    <MudToggleItem Value="@("3h")" />
                    <MudToggleItem Value="@("12h")" />
                    <MudToggleItem Value="@("1d")" />
                    <MudToggleItem Value="@("3d")" />
                    <MudToggleItem Value="@("1w")" />
                </MudToggleGroup>
                <MudButton Class="pl-3" Color="Color.Primary" Variant="Variant.Outlined"
                           Disabled="_loading" OnClick="RefreshAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" />
                </MudButton>
            </div>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
        }

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_entries.Count == 0)
        {
            <MudText Color="Color.Secondary" Class="pa-4">No HTTP requests in the selected range.</MudText>
        }
        else
        {
            <MudTable T="LoadBalancerLogEntry" Items="@_entries" Dense="true" Hover="true"
                      Outlined="true" FixedHeader="true" Height="32rem"
                      HorizontalScrollbar="true" Breakpoint="Breakpoint.Sm"
                      Class="tilework-lb-log-table" aria-label="@Title">
                <ColGroup>
                    <col style="width: 3rem" />
                    <col style="width: 15rem" />
                    <col />
                    <col style="width: 10rem" />
                    <col style="width: 12rem" />
                    <col />
                    <col style="width: 6rem" />
                    <col style="width: 8rem" />
                </ColGroup>
                <HeaderContent>
                    <MudTh />
                    <MudTh>Timestamp</MudTh>
                    <MudTh>Action</MudTh>
                    <MudTh>Source</MudTh>
                    <MudTh>Host</MudTh>
                    <MudTh>Request</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Class="tilework-lb-log-number">Total time</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudIconButton Icon="@(IsExpanded(context) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                       Size="Size.Small"
                                       OnClick="@(() => ToggleDetails(context))"
                                       title="@(IsExpanded(context) ? "Hide request details" : "Show request details")" />
                    </MudTd>
                    <MudTd DataLabel="Timestamp" Class="tilework-lb-log-timestamp">@FormatTimestamp(context.Timestamp)</MudTd>
                    <MudTd DataLabel="Action">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" title="@FormatAction(context)">
                            <MudIcon Icon="@GetActionIcon(context.Action)"
                                     Color="@(context.Action == LoadBalancerLogAction.ForwardingFailed ? Color.Error : Color.Default)"
                                     Size="Size.Small" />
                            @if (!string.IsNullOrWhiteSpace(context.Backend))
                            {
                                <span>@context.Backend</span>
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Source"><code>@context.SourceAddress</code></MudTd>
                    <MudTd DataLabel="Host"><code>@(context.HostHeader ?? "—")</code></MudTd>
                    <MudTd DataLabel="Request" Class="tilework-lb-log-request">
                        <div class="tilework-lb-log-request-content">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@context.Method.Method</MudChip>
                            <code class="tilework-lb-log-path" title="@context.Path">@context.Path</code>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@GetStatusColor(context.StatusCode)">
                            @((int)context.StatusCode)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Total time" Class="tilework-lb-log-number">@context.TotalTimeMilliseconds.ToString("N0", CultureInfo.InvariantCulture) ms</MudTd>
                </RowTemplate>
                <ChildRowContent>
                    @if (IsExpanded(context))
                    {
                        <MudTr>
                            <td colspan="8" class="pa-0">
                                <MudCard Elevation="0" Square="true" Class="tilework-lb-log-details ma-0 pa-0">
                                    <MudCardContent Class="pa-0">
                                        <MudSimpleTable Dense="true" Elevation="0" Square="true" Class="tilework-lb-log-detail-table ma-0">
                                            <colgroup>
                                                <col style="width: 10rem" />
                                                <col />
                                                <col style="width: 10rem" />
                                                <col />
                                            </colgroup>
                                            <tbody>
                                                <tr>
                                                    <th scope="row">Timestamp</th>
                                                    <td><code>@FormatTimestamp(context.Timestamp)</code></td>
                                                    <th scope="row">Action</th>
                                                    <td><code>@FormatAction(context)</code></td>
                                                </tr>
                                                <tr>
                                                    <th scope="row">Source</th>
                                                    <td><code>@context.SourceAddress</code></td>
                                                    <th scope="row">Host</th>
                                                    <td><code>@(context.HostHeader ?? "—")</code></td>
                                                </tr>
                                                <tr>
                                                    <th scope="row">Request</th>
                                                    <td><code>@context.Method.Method @context.Path</code></td>
                                                    <th scope="row">Status</th>
                                                    <td><code>@((int)context.StatusCode)</code></td>
                                                </tr>
                                                <tr>
                                                    <th scope="row">Total time</th>
                                                    <td><code>@context.TotalTimeMilliseconds.ToString("N0", CultureInfo.InvariantCulture) ms</code></td>
                                                    <th scope="row">X-Forwarded-For</th>
                                                    <td><code>@(context.XForwardedFor ?? "—")</code></td>
                                                </tr>
                                                <tr>
                                                    <th scope="row">User agent</th>
                                                    <td colspan="3"><code>@(context.UserAgent ?? "—")</code></td>
                                                </tr>
                                            </tbody>
                                        </MudSimpleTable>
                                    </MudCardContent>
                                </MudCard>
                            </td>
                        </MudTr>
                    }
                </ChildRowContent>
            </MudTable>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public string Title { get; set; } = "Logs";

    [Parameter]
    public Func<DateTimeOffset, DateTimeOffset, SortOrder, Task<List<LoadBalancerLogEntry>>>? LoadData { get; set; }

    [Inject]
    private IBrowserTimeZoneProvider BrowserTimeZoneProvider { get; set; } = default!;

    private string _selectedRange = "1h";
    private List<LoadBalancerLogEntry> _entries = new();
    private LoadBalancerLogEntry? _expandedEntry;
    private bool _loading;
    private bool _initialized;
    private string? _error;
    private TimeZoneInfo? _browserTimeZone;
    private int _requestVersion;

    public async Task RefreshAsync()
    {
        if (LoadData == null)
            return;

        var requestVersion = ++_requestVersion;
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var to = DateTimeOffset.UtcNow;
            var from = GetRangeStart(_selectedRange, to);
            var entries = await LoadData(from, to, SortOrder.Ascending) ?? new();
            var browserTimeZone = _browserTimeZone ?? await BrowserTimeZoneProvider.GetTimeZoneAsync();

            if (requestVersion == _requestVersion)
            {
                _entries = entries;
                _expandedEntry = null;
                _browserTimeZone = browserTimeZone;
            }
        }
        catch (Exception exception)
        {
            if (requestVersion == _requestVersion)
            {
                _entries = new();
                _expandedEntry = null;
                _error = $"Failed to load logs: {exception.Message}";
            }
        }
        finally
        {
            if (requestVersion == _requestVersion)
            {
                _loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await RefreshAsync();
        }
    }

    private Task OnRangeChanged(string range)
    {
        _selectedRange = range;
        return RefreshAsync();
    }

    private bool IsExpanded(LoadBalancerLogEntry entry)
    {
        return ReferenceEquals(_expandedEntry, entry);
    }

    private void ToggleDetails(LoadBalancerLogEntry entry)
    {
        _expandedEntry = IsExpanded(entry) ? null : entry;
    }

    private string FormatTimestamp(DateTimeOffset timestamp)
    {
        var localized = _browserTimeZone == null
            ? timestamp.ToLocalTime()
            : TimeZoneInfo.ConvertTime(timestamp, _browserTimeZone);

        return localized.ToString("yyyy-MM-dd HH:mm:ss.fff zzz", CultureInfo.InvariantCulture);
    }

    private static string FormatAction(LoadBalancerLogEntry entry)
    {
        return entry.Action switch
        {
            LoadBalancerLogAction.Forwarded => $"Forwarded - {entry.Backend}",
            LoadBalancerLogAction.ForwardingFailed => $"Failed - {entry.Backend}",
            _ => "Fixed response"
        };
    }

    private static string GetActionIcon(LoadBalancerLogAction action)
    {
        return action switch
        {
            LoadBalancerLogAction.Forwarded => Icons.Material.Outlined.AltRoute,
            LoadBalancerLogAction.ForwardingFailed => Icons.Material.Filled.ErrorOutline,
            _ => Icons.Material.Outlined.Dns
        };
    }

    private static Color GetStatusColor(HttpStatusCode statusCode)
    {
        var numericStatus = (int)statusCode;
        if (numericStatus < 300)
            return Color.Success;
        if (numericStatus < 400)
            return Color.Warning;

        return Color.Error;
    }

    private static DateTimeOffset GetRangeStart(string range, DateTimeOffset to)
    {
        return range switch
        {
            "1h" => to.AddHours(-1),
            "3h" => to.AddHours(-3),
            "12h" => to.AddHours(-12),
            "1d" => to.AddDays(-1),
            "3d" => to.AddDays(-3),
            "1w" => to.AddDays(-7),
            _ => to.AddHours(-1)
        };
    }
}
